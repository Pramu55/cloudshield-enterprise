# CloudShield public read-only demo environment example.
# Copy or transform this file outside Git only when runtime execution is approved.
# Do not commit .env.public-demo or any file containing real runtime secrets.

POSTGRES_DB=cloudshield
POSTGRES_USER=cloudshield
POSTGRES_PASSWORD=change_me_to_a_long_random_demo_password

FRONTEND_PORT=3100
BACKEND_PORT=4100

# Local isolated Gate 2C validation uses localhost HTTP and must not be treated
# as a production-readiness claim. Production demos must set
# PUBLIC_DEMO_NODE_ENV=production, HTTPS origins, and secure cookies.
PUBLIC_DEMO_NODE_ENV=development

PUBLIC_FRONTEND_ORIGIN=http://localhost:3100
PUBLIC_API_BASE_URL=http://localhost:4100

# Backend runtime safety. Always provide long random values from outside Git.
JWT_SECRET=replace_with_a_long_random_public_demo_jwt_secret
CSRF_HMAC_KEY=replace_with_a_long_random_public_demo_csrf_hmac_key
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:3100
TRUST_PROXY=false

# For production VPS/demo domain:
# PUBLIC_DEMO_NODE_ENV=production
# PUBLIC_FRONTEND_ORIGIN=https://cloudshield.yourdomain.com
# PUBLIC_API_BASE_URL=https://api.cloudshield.yourdomain.com
# FRONTEND_URL=https://cloudshield.yourdomain.com
# AUTH_COOKIE_SECURE=true
# TRUST_PROXY=true

# Optional hosted Redis for Render/Upstash deployments.
# Keep empty for local Docker Compose because docker-compose.public-demo.yml uses REDIS_HOST=redis internally.
REDIS_URL=

AWS_REGION_DEFAULT=us-east-1
