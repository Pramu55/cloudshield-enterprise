# CloudShield public read-only demo deployment example.
# Copy this file to .env.public-demo and change values before deploying.
# Do not commit .env.public-demo.

POSTGRES_DB=cloudshield
POSTGRES_USER=cloudshield
POSTGRES_PASSWORD=change_me_to_a_long_random_demo_password

FRONTEND_PORT=3100
BACKEND_PORT=4100

PUBLIC_FRONTEND_ORIGIN=http://localhost:3100
PUBLIC_API_BASE_URL=http://localhost:4100

# Backend production runtime safety.
# Public production demos must use long random values and an exact https origin.
JWT_SECRET=replace_with_a_long_random_public_demo_jwt_secret
CSRF_HMAC_KEY=replace_with_a_long_random_public_demo_csrf_hmac_key
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
FRONTEND_URL=https://cloudshield.yourdomain.com
TRUST_PROXY=true

# For VPS/demo domain:
# PUBLIC_FRONTEND_ORIGIN=https://cloudshield.yourdomain.com
# PUBLIC_API_BASE_URL=https://api.cloudshield.yourdomain.com

# Optional hosted Redis for Render/Upstash deployments.
# Keep empty for local Docker Compose because docker-compose.public-demo.yml uses REDIS_HOST=redis internally.
REDIS_URL=

AWS_REGION_DEFAULT=us-east-1
